{
  "name": "lifeos",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "node scripts/copy-canvaskit.js && expo export --platform web && node scripts/post-export-web.js",
    "web:serve": "npx serve dist -l 4173 --single",
    "web:tunnel": "npx ngrok http 4173",
    "web:preview": "npm run web:export && npm run web:serve",
    "deploy": "npm run web:export && npx wrangler pages deploy dist --project-name=lifeos-6r5 --branch=lifeos --commit-dirty=true",
    "test": "jest",
    "typecheck": "node --stack-size=8000 node_modules/typescript/bin/tsc --noEmit",
    "test:watch": "jest --watch",
    "test:components": "jest --selectProjects components",
    "evals": "jest --testPathPatterns=evals --runInBand",
    "evals:live": "EVAL_REAL=true jest --testPathPatterns=evals --runInBand",
    "smoke": "cross-env SMOKE_BASE_URL=https://lifeos-6r5-eqa.pages.dev playwright test --project=smoke",
    "smoke:local": "playwright test --project=smoke",
    "smoke:mobile": "playwright test --project=smoke-mobile",
    "e2e": "playwright test --project=chromium",
    "e2e:auth": "playwright test --project=authenticated",
    "e2e:cuj": "playwright test --project=cuj",
    "e2e:cuj:local": "CUJ_BASE_URL=http://localhost:8081 playwright test --project=cuj",
    "e2e:create-test-user": "npx ts-node e2e/create-test-user.ts",
    "visual": "playwright test --project=visual",
    "visual:update": "playwright test --project=visual --update-snapshots",
    "verify": "npm run typecheck && jest && npm run smoke",
    "gen:onboarding-audio": "node scripts/generate-onboarding-audio.js"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rive-app/react-canvas": "^4.29.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.104.0",
    "@tanstack/react-query": "^5.90.21",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-calendar": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-health": "^0.0.0",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^1.17.0",
    "nanoid": "^5.1.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-fast-confetti": "^2.0.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "rive-react-native": "^9.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "cross-env": "^10.1.0",
    "eas-cli": "^20.0.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.3.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2",
    "xlsx": "^0.18.5"
  },
  "private": true
}
