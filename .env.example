# AI — Expo only exposes env vars prefixed EXPO_PUBLIC_ to the client bundle.
# Use EXPO_PUBLIC_ANTHROPIC_API_KEY for in-app calls.
# (ANTHROPIC_API_KEY without the prefix is read by Node-side scripts/tests only.)
EXPO_PUBLIC_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=

# AI mock mode (no AI calls made — uses static responses)
USE_AI_MOCK=false
EXPO_PUBLIC_USE_AI_MOCK=false

# Google OAuth — for Calendar / Fit / Gmail post-signin integrations. Web only.
# Create an OAuth 2.0 Client ID in Google Cloud Console (Web application type),
# add http://localhost:8081/gmail-callback (and the other callback paths) as
# authorised redirect URIs.
#
# Token exchange runs server-side via the Worker — set GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET there with `wrangler secret put`. They must match the
# values from the same OAuth client. There is intentionally no
# EXPO_PUBLIC_GOOGLE_CLIENT_SECRET — secrets must never ship in the bundle.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# AI proxy — Cloudflare Worker URL. The Worker holds the Claude + Gemini keys
# server-side. For local dev, run `wrangler dev` in workers/ai-proxy/ and use
# http://localhost:8787 here.
EXPO_PUBLIC_AI_PROXY_URL=

# Supabase — used for auth + encrypted backups (Phase 1 ship). Anon key is safe
# to include in the client bundle; the service role key MUST stay server-side.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ElevenLabs — dev-time only. Used by `npm run gen:onboarding-audio` to render
# the onboarding narration MP3s into assets/audio/onboarding/. The app itself
# never calls ElevenLabs at runtime — it plays the bundled MP3s. Free tier
# (10k chars/month) is enough for onboarding regeneration during dev. Get a
# key at https://elevenlabs.io/.
# Optional: ELEVENLABS_VOICE_ID (default: Rachel — 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
