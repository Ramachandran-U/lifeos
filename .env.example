# AI — Expo only exposes env vars prefixed EXPO_PUBLIC_ to the client bundle.
# Use EXPO_PUBLIC_ANTHROPIC_API_KEY for in-app calls.
# (ANTHROPIC_API_KEY without the prefix is read by Node-side scripts/tests only.)
EXPO_PUBLIC_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=

# AI mock mode (no AI calls made — uses static responses)
USE_AI_MOCK=false
EXPO_PUBLIC_USE_AI_MOCK=false

# Supabase — Phase 2, leave blank for Phase 1
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Plaid — Phase 3, leave blank
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Google OAuth — for Gmail-powered transaction sync (Finance). Web only.
# Create an OAuth 2.0 Client ID in Google Cloud Console, add
# http://localhost:8081/gmail-callback as an authorised redirect URI.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# AI proxy — Cloudflare Worker URL. The Worker holds the Claude + Gemini keys
# server-side. For local dev, run `wrangler dev` in workers/ai-proxy/ and use
# http://localhost:8787 here.
EXPO_PUBLIC_AI_PROXY_URL=

# Supabase — used for auth + encrypted backups (Phase 1 ship). Anon key is safe
# to include in the client bundle; the service role key MUST stay server-side.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
