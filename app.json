{
  "expo": {
    "name": "LifeOS",
    "slug": "lifeos",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "lifeos",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "LifeOS syncs your routine to your calendar."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "LifeOS reads your contacts only so you can pick people to add to your Social Hub. Names and details stay on this device and are never sent to any server."
        }
      ],
      "expo-web-browser",
      "expo-audio"
    ],
    "ios": {
      "bundleIdentifier": "com.lifeos.app",
      "supportsTablet": false,
      "buildNumber": "1"
    },
    "android": {
      "package": "com.lifeos.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "devClient": {
      "port": 8082
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9461da04-8994-408a-ac95-de511c9bd783"
      }
    },
    "owner": "vibecoder1122"
  }
}
