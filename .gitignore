# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# Supabase CLI scratch dirs — local-only state (branch metadata, temp downloads),
# never meant to be committed.
supabase/.branches/
supabase/.temp/

# generated native folders
/ios
/android

# Runtime logs
expo.log
ai-proxy.log
tmp/
test-results/
smoke-output/
playwright-report/
.auth/
.env.test
.claude/

# Generated eval output — regenerated on every `npm run evals` / benchmark run.
# (production-outcomes.md is an intentional stub and stays tracked.)
evals/reports/latest.md
evals/reports/latest.json
evals/reports/traces.jsonl
evals/reports/benchmark-merchant.md
