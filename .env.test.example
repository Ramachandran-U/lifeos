# Playwright E2E test credentials. Create a test user first:
#   1. Run: SUPABASE_SERVICE_ROLE_KEY=... npx ts-node e2e/create-test-user.ts
#   2. Or manually in Supabase dashboard → Auth → Users → Add user (auto-confirm email)
#   3. Copy the credentials here and rename this file to .env.test

PLAYWRIGHT_TEST_EMAIL=lifeos-e2e-test@example.com
PLAYWRIGHT_TEST_PASSWORD=LifeOS-E2E-Test-2026!

# Where to test against (defaults to localhost:8081 if not set)
# SMOKE_BASE_URL=https://your-deploy.lifeos-6r5-eqa.pages.dev
